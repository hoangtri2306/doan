# ── Backend env (copy sang .env và điền giá trị thật) ─────────────────────────
# Lưu ý: .env KHÔNG được commit (gitignored). Dùng secret ngẫu nhiên dài cho JWT.

# Server
NODE_ENV=development
PORT=5000

# Database (MongoDB — local hoặc Atlas)
MONGO_URI=mongodb://localhost:27017/blog-platform

# Auth — BẮT BUỘC dùng secret mạnh (VD: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
JWT_ACCESS_SECRET=replace_with_long_random_secret
JWT_REFRESH_SECRET=replace_with_long_random_secret
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# CORS
CLIENT_URL=http://localhost:3000

# Cloudinary (tùy chọn — nếu bỏ trống sẽ fallback lưu file local /uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI moderation service
AI_SERVICE_URL=http://localhost:8000
AI_TIMEOUT_MS=10000
# Nếu set AI_API_KEY, AI service yêu cầu header X-API-Key (nếu để trống: không auth)
AI_API_KEY=

# Đặt 1 nếu backend chạy sau reverse proxy (Nginx/Heroku) để rate-limit đúng IP
TRUST_PROXY=
